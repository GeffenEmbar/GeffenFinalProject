<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/base_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/main_gradient">

    <FrameLayout
        android:id="@+id/base_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@color/black"
        android:elevation="8dp"
        android:paddingHorizontal="4dp">

        <Button
            android:id="@+id/btnUserMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="User Menu"
            android:drawableTop="@drawable/ic_home"
            android:drawablePadding="0dp"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:padding="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnLeaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Leaderboard"
            android:drawableTop="@drawable/ic_leaderboard"
            android:drawablePadding="0dp"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:padding="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnGroups"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Groups"
            android:drawableTop="@drawable/ic_groups"
            android:drawablePadding="0dp"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:padding="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profile"
            android:drawableTop="@drawable/ic_profile"
            android:drawablePadding="0dp"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:padding="2dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSignOut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Sign Out"
            android:drawableTop="@drawable/ic_signout"
            android:drawablePadding="0dp"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:padding="2dp"
            android:textAllCaps="false" />

    </LinearLayout>
</LinearLayout>
