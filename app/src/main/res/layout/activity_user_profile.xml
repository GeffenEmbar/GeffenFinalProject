<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".user_profile">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/black">

            <!-- TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:text="User Profile"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:gravity="center" />

            <!-- PROFILE IMAGE -->
            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera"
                android:layout_marginBottom="16dp" />

            <!-- FIRST NAME -->
            <TextView
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="First Name"
                android:textColor="@color/white"
                android:textColorHint="#888"
                android:textSize="18sp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"/>

            <!-- LAST NAME -->
            <TextView
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Last Name"
                android:textColor="@color/white"
                android:textColorHint="#888"
                android:textSize="18sp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"/>

            <!-- PHONE -->
            <TextView
                android:id="@+id/etPhoneNum"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Phone"
                android:textColor="@color/white"
                android:textColorHint="#888"
                android:textSize="18sp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"/>

            <!-- GROUP LABEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Group:"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginTop="8dp"/>

            <!-- GROUP NAME -->
            <TextView
                android:id="@+id/tvGroupName"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:gravity="center_vertical"/>

            <!-- RANK LABEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ranks in Group:"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvNotesRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notes Rank: N/A"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvIntervalsRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intervals Rank: N/A"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvChordsRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chords Rank: N/A"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvQuizRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="General Quiz Rank: N/A"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"/>

            <!-- NOTES STATS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notes Quiz (C/W | Streak | Max):"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tvNotesStats"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:gravity="center_vertical"/>

            <!-- INTERVALS STATS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intervals Quiz (C/W | Streak | Max):"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tvIntervalsStats"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:gravity="center_vertical"/>

            <!-- CHORDS STATS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chords Quiz (C/W | Streak | Max):"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tvChordsStats"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:gravity="center_vertical"/>

            <!-- QUIZ STATS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="General Quiz (C/W | Streak | Max):"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tvQuizStats"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:gravity="center_vertical"/>

            <!-- TOTAL STATS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total (Correct/Wrong):"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/tvTotalStats"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:gravity="center_vertical"/>

            <!-- UPDATE BUTTON -->
            <Button
                android:id="@+id/btnGoToUpdate"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Update Profile"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>