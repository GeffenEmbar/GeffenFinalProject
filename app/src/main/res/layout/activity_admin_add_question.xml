<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_gradient"
    android:padding="24dp"
    tools:context=".admin_add_question">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="Add Question"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/question"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edit_text_background"
                android:hint="Enter question"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="#757575" />

            <EditText
                android:id="@+id/correct"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edit_text_background"
                android:hint="Enter correct answer"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="#757575" />

            <EditText
                android:id="@+id/wrong1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edit_text_background"
                android:hint="Enter first wrong answer"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="#757575" />

            <EditText
                android:id="@+id/wrong2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edit_text_background"
                android:hint="Enter second wrong answer"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="#757575" />

            <EditText
                android:id="@+id/wrong3"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edit_text_background"
                android:hint="Enter third wrong answer"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="#757575" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Difficulty:"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/difficulty"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/edit_text_background"
                android:entries="@array/spin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/button_primary"
                android:text="Add Question"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>