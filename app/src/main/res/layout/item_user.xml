<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#1AFFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#33FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_user_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/tv_user_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="JD"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Rank Badge -->
        <TextView
            android:id="@+id/tv_rank"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/button_primary"
            android:backgroundTint="@color/secondary"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/primary_dark"
            android:textSize="9sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/card_avatar"
            app:layout_constraintEnd_toEndOf="@id/card_avatar" />

        <TextView
            android:id="@+id/tv_item_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="John Doe"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/chip_user_role"
            app:layout_constraintStart_toEndOf="@id/card_avatar"
            app:layout_constraintTop_toTopOf="@id/card_avatar"
            tools:text="@tools:sample/full_names" />

        <TextView
            android:id="@+id/chip_user_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_primary"
            android:backgroundTint="@color/accent"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="ADMIN"
            android:textColor="@color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_item_user_name"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_item_user_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="john.doe@example.com"
            android:textColor="#BDBDBD"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_item_user_name"
            app:layout_constraintTop_toBottomOf="@id/tv_item_user_name" />

        <TextView
            android:id="@+id/tv_item_user_phone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="+1 234 567 8900"
            android:textColor="#BDBDBD"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_item_user_name"
            app:layout_constraintTop_toBottomOf="@id/tv_item_user_email" />

        <LinearLayout
            android:id="@+id/layout_stats_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_kick"
            app:layout_constraintTop_toBottomOf="@id/tv_item_user_phone"
            app:layout_goneMarginTop="6dp">

            <TextView
                android:id="@+id/tv_item_user_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N: 0"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:background="#1AFFFFFF"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tv_item_user_intervals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I: 0"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:background="#1AFFFFFF"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tv_item_user_quiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q: 0"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:background="#1AFFFFFF"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tv_item_user_chords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C: 0"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:background="#1AFFFFFF"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tv_item_user_complex_chords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CC: 0"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:background="#1AFFFFFF"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_kick"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="4dp"
            android:text="Kick"
            android:textColor="@color/error"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_stats_row"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>