<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Rank Display -->
        <TextView
            android:id="@+id/tv_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:elevation="10dp"
            android:text="#1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Left Accent Panel -->
        <View
            android:id="@+id/view_accent"
            android:layout_width="100dp"
            android:layout_height="0dp"
            android:background="#3949AB"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_avatar"
            android:layout_width="68dp"
            android:layout_height="68dp"
            app:cardCornerRadius="34dp"
            app:cardElevation="4dp"
            app:strokeWidth="3dp"
            app:strokeColor="#FFFFFF"
            app:cardBackgroundColor="#E8EAF6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/view_accent"
            app:layout_constraintStart_toStartOf="@id/view_accent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_user_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/tv_user_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="JD"
                android:textColor="#3949AB"
                android:textSize="24sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Right Content Panel -->
        <TextView
            android:id="@+id/tv_item_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:text="John Doe"
            android:textColor="#3949AB"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/chip_user_role"
            app:layout_constraintStart_toEndOf="@id/view_accent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@tools:sample/full_names" />

        <LinearLayout
            android:id="@+id/layout_email_pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="#F5F5F5"
            android:backgroundTint="#F0F4FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_item_user_name"
            app:layout_constraintTop_toBottomOf="@id/tv_item_user_name">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_dialog_email"
                app:tint="#3949AB" />

            <TextView
                android:id="@+id/tv_item_user_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="john.doe@example.com"
                android:textColor="#5C6BC0"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_phone_pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:background="#F5F5F5"
            android:backgroundTint="#F0F4FF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_item_user_name"
            app:layout_constraintTop_toBottomOf="@id/layout_email_pill">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/sym_action_call"
                app:tint="#3949AB" />

            <TextView
                android:id="@+id/tv_item_user_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="+1 234 567 8900"
                android:textColor="#5C6BC0"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chip_user_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="#FF4081"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="ADMIN"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layout_stats_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="@id/tv_item_user_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_phone_pill"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_item_user_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N: 0"
                android:textColor="#3949AB"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_item_user_intervals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I: 0"
                android:textColor="#3949AB"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_item_user_quiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q: 0"
                android:textColor="#3949AB"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_item_user_chords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C: 0"
                android:textColor="#3949AB"
                android:textSize="11sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tv_item_user_complex_chords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CC: 0"
                android:textColor="#3949AB"
                android:textSize="11sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_kick"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kick"
            android:textColor="#D32F2F"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>