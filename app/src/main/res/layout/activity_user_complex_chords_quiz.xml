<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".user_complex_chords_quiz">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complex Chords Quiz"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correct: 0"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:layout_marginEnd="20dp"/>

            <TextView
                android:id="@+id/wrongText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wrong: 0"
                android:textColor="#F44336"
                android:textSize="18sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnPlayChord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play Random Chord"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnReplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Replay Chord"
            android:backgroundTint="#FF9800"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Root:"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="3"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootC"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="C"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootCSharp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="C#"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootD"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="D"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootDSharp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="D#"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootE"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="E"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootF"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="F"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootFSharp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="F#"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootG"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="G"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootGSharp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="G#"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootA"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="A"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootASharp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="A#"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRootB"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="B"
                android:textColor="@color/white"
                app:strokeColor="@color/white"/>

        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diminished"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/white"
                app:trackTint="#2196F3"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Augmented"
                android:textColor="@color/white"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnCheckAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Answer"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Menu"
            android:backgroundTint="#9E9E9E"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
